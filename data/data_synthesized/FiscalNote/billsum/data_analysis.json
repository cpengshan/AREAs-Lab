"{\n  \"dataset_metadata\": {\n    \"domain\": \"Legal / US Legislation\",\n    \"total_instances\": \"23,455\",\n    \"languages\": [\"en\"],\n    \"primary_data_type\": \"Parallel Corpora\",\n    \"description\": \"BillSum is a dataset for automatic summarization of US Congressional and California state bills. It comprises text from US Congressional bills (103rd-115th sessions) and California state bills (2015-2016 session), paired with human-written summaries from official sources like the Government Publishing Office (GPO) and the California Legislative Counsel. It serves as a benchmark for long-form, domain-specific summarization in the legal field.\"\n  },\n  \"schema_analysis\": [\n    {\n      \"column_name\": \"text\",\n      \"data_type\": \"string\",\n      \"description\": \"The full-length body text of the legislative bill containing sections, subsections, and legal clauses.\",\n      \"is_text\": true,\n      \"avg_length\": \"2,500 words\"\n    },\n    {\n      \"column_name\": \"summary\",\n      \"data_type\": \"string\",\n      \"description\": \"The human-written official summary explaining the bill's intent and provisions in plain language.\",\n      \"is_text\": true,\n      \"avg_length\": \"200 words\"\n    },\n    {\n      \"column_name\": \"title\",\n      \"data_type\": \"string\",\n      \"description\": \"The official short or long title of the bill as introduced.\",\n      \"is_text\": true,\n      \"avg_length\": \"15 words\"\n    },\n    {\n      \"column_name\": \"text_len\",\n      \"data_type\": \"int\",\n      \"description\": \"Number of characters in the 'text' field (primarily present in US Congressional subsets).\",\n      \"is_text\": False,\n      \"avg_length\": null\n    },\n    {\n      \"column_name\": \"sum_len\",\n      \"data_type\": \"int\",\n      \"description\": \"Number of characters in the 'summary' field (primarily present in US Congressional subsets).\",\n      \"is_text\": False,\n      \"avg_length\": null\n    }\n  ],\n  \"structural_logic\": {\n    \"relationships\": \"The 'text' field acts as the source document, while 'summary' serves as the ground truth target. The 'title' can be used as supplementary context or a separate compression task.\",\n    \"label_dynamics\": \"The dataset is split into US training (18,949), US test (3,269), and an out-of-domain California test set (1,237) to evaluate zero-shot generalization across legislative jurisdictions.\",\n    \"potential_bottlenecks\": \"Long-form text frequently exceeds the 512 or 1024 token context limits of standard Transformer models; contains highly specialized legal terminology and formal structural headers that may require custom preprocessing.\"\n  }\n}"